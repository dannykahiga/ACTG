<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="314.0" prefWidth="468.0" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Unit_Controller">
   <children>
      <ListView fx:id="listviewUnits" prefHeight="283.0" prefWidth="369.0" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER" prefHeight="42.0" prefWidth="468.0">
         <children>
            <TextField fx:id="departmentText" prefHeight="26.0" prefWidth="0.0" visible="false" />
            <TextField fx:id="textNumberOfStudents" prefHeight="26.0" prefWidth="0.0" visible="false" />
            <JFXButton fx:id="completeAddingUnits" buttonType="RAISED" onAction="#goBackToAddingCourse" prefHeight="5.0" prefWidth="193.0" style="-fx-background-color: #4caf50;" text="Complete Adding Units" textFill="WHITE">
               <graphic>
                  <ImageView fitHeight="21.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Icons/ok.png" />
                     </image>
                  </ImageView>
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </JFXButton>
            <TextField fx:id="textFieldCourse" prefHeight="26.0" prefWidth="0.0" visible="false" />
         </children>
      </HBox>
   </children>
</VBox>
